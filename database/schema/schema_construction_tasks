-- Construction Project Tasks Table
-- Links to existing projects table and provides Gantt chart data

create table public.construction_tasks (
  id uuid not null default gen_random_uuid(),
  project_id uuid not null,
  task_id character varying(100) not null, -- Custom ID for dependencies
  parent_task_id uuid null, -- Parent task for subtasks
  name character varying not null,
  type character varying(20) not null default 'task', -- phase, milestone, task, subtask
  start_date date not null,
  end_date date not null,
  progress integer not null default 0, -- 0-100
  status character varying(20) not null default 'not-started', -- not-started, in-progress, completed, on-hold, delayed
  priority character varying(20) not null default 'medium', -- low, medium, high, critical
  dependencies text null, -- Comma-separated task IDs
  assignee character varying null,
  description text null,
  cost numeric(15,2) null,
  actual_start date null,
  actual_end date null,
  notes text null,
  
  -- Area and Location fields
  main_area_id uuid null,
  sub_area_1_id uuid null,
  location_detail text null, -- Specific location description (e.g., "Building A, 3rd Floor, Room 301")
  
  crew character varying null,
  equipment text null, -- JSON array or comma-separated
  materials text null, -- JSON array or comma-separated
  
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  created_by uuid null,
  
  constraint construction_tasks_pkey primary key (id),
  constraint construction_tasks_project_id_fkey foreign key (project_id) references public.projects (id) on delete cascade,
  constraint construction_tasks_parent_task_id_fkey foreign key (parent_task_id) references public.construction_tasks (id) on delete cascade,
  constraint construction_tasks_main_area_id_fkey foreign key (main_area_id) references public.main_areas (id) on delete set null,
  constraint construction_tasks_sub_area_1_id_fkey foreign key (sub_area_1_id) references public.sub_areas_1 (id) on delete set null,
  constraint construction_tasks_created_by_fkey foreign key (created_by) references public.users (id) on delete set null,
  constraint construction_tasks_progress_check check (progress >= 0 and progress <= 100)
) tablespace pg_default;

-- Indexes
create index idx_construction_tasks_project_id on public.construction_tasks using btree (project_id) tablespace pg_default;
create index idx_construction_tasks_parent_task_id on public.construction_tasks using btree (parent_task_id) tablespace pg_default;
create index idx_construction_tasks_status on public.construction_tasks using btree (status) tablespace pg_default;
create index idx_construction_tasks_start_date on public.construction_tasks using btree (start_date) tablespace pg_default;
create index idx_construction_tasks_end_date on public.construction_tasks using btree (end_date) tablespace pg_default;
create index idx_construction_tasks_main_area_id on public.construction_tasks using btree (main_area_id) tablespace pg_default;
create index idx_construction_tasks_task_id on public.construction_tasks using btree (task_id) tablespace pg_default;

-- RLS Policies (adjust based on your existing RLS structure)
alter table public.construction_tasks enable row level security;

-- Policy: Users can view tasks for projects they have access to
-- This is a basic example - adjust to match your existing RLS patterns
create policy "Users can view construction tasks for their projects"
  on public.construction_tasks
  for select
  using (
    exists (
      select 1 from public.projects
      where projects.id = construction_tasks.project_id
    )
  );

-- Policy: Authenticated users can insert tasks
create policy "Authenticated users can insert construction tasks"
  on public.construction_tasks
  for insert
  with check (auth.uid() is not null);

-- Policy: Users can update tasks for their projects
create policy "Users can update construction tasks for their projects"
  on public.construction_tasks
  for update
  using (
    exists (
      select 1 from public.projects
      where projects.id = construction_tasks.project_id
    )
  );

-- Policy: Users can delete tasks for their projects
create policy "Users can delete construction tasks for their projects"
  on public.construction_tasks
  for delete
  using (
    exists (
      select 1 from public.projects
      where projects.id = construction_tasks.project_id
    )
  );

-- Comments
comment on table public.construction_tasks is 'Construction project tasks for Gantt chart planning';
comment on column public.construction_tasks.task_id is 'Custom task identifier used for dependencies (e.g., task-1-1)';
comment on column public.construction_tasks.main_area_id is 'Main area/zone where this task is performed';
comment on column public.construction_tasks.sub_area_1_id is 'Sub-area within main area for more specific location';
comment on column public.construction_tasks.location_detail is 'Detailed location description (e.g., Building A, Floor 3, Room 301)';
comment on column public.construction_tasks.dependencies is 'Comma-separated list of task_id values that must complete before this task';

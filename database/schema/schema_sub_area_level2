create table public.sub_areas_level2 (
  id uuid not null default gen_random_uuid (),
  sub_area1_id uuid not null,
  name character varying(100) not null,
  description text null,
  code character varying(20) null,
  display_order integer null default 0,
  is_active boolean null default true,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  constraint sub_areas_level2_pkey primary key (id),
  constraint sub_areas_level2_sub_area1_id_fkey foreign KEY (sub_area1_id) references sub_areas_level1 (id) on delete CASCADE
) TABLESPACE pg_default;
-- Stores table: Physical storage locations within projects
create table public.stores (
  id uuid not null default gen_random_uuid(),
  store_code character varying(50) not null,
  store_name character varying(200) not null,
  store_name_th character varying(200) null,
  project_id uuid not null,
  company_id uuid null,
  store_type character varying(50) null default 'warehouse'::character varying, -- warehouse, site_storage, tool_room, etc.
  location_address text null,
  store_manager_id uuid null, -- FK to users/employees
  contact_phone character varying(50) null,
  is_main_store boolean null default false,
  is_active boolean null default true,
  created_by character varying(50) null,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  constraint stores_pkey primary key (id),
  constraint stores_store_code_key unique (store_code),
  constraint stores_project_id_fkey foreign key (project_id) references projects (id) on delete cascade,
  constraint stores_company_id_fkey foreign key (company_id) references companies (id) on delete set null
) tablespace pg_default;

create index if not exists idx_stores_project on public.stores using btree (project_id) tablespace pg_default;
create index if not exists idx_stores_company on public.stores using btree (company_id) tablespace pg_default;
create index if not exists idx_stores_code on public.stores using btree (store_code) tablespace pg_default;
create index if not exists idx_stores_active on public.stores using btree (is_active) tablespace pg_default;
create index if not exists idx_stores_type on public.stores using btree (store_type) tablespace pg_default;

comment on table public.stores is 'Physical storage locations (warehouses, site stores) within projects';
comment on column public.stores.store_type is 'Type: warehouse, site_storage, tool_room, consumables_store, etc.';
comment on column public.stores.is_main_store is 'Indicates the primary/main store for the project';

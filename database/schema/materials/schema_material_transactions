-- Material Transactions: Complete audit trail of all inventory movements
create table public.material_transactions (
  id uuid not null default gen_random_uuid(),
  transaction_number character varying(50) not null default (
    'TXN-'::text || to_char(now(), 'YYYYMMDD-HH24MISS-MS'::text)
  ),
  material_inventory_id uuid not null,
  store_id uuid not null,
  project_id uuid not null,
  
  -- Transaction details
  transaction_type character varying(50) not null, -- receive, issue, transfer, adjustment, return
  transaction_date timestamp with time zone not null default now(),
  
  -- Quantity changes
  quantity_change numeric(15, 3) not null, -- Positive for additions, negative for deductions
  quantity_before numeric(15, 3) not null,
  quantity_after numeric(15, 3) not null,
  
  -- Cost tracking
  unit_cost numeric(15, 2) null,
  total_cost numeric(15, 2) generated always as (abs(quantity_change) * unit_cost) stored,
  
  -- Reference documents
  reference_type character varying(50) null, -- receive, requisition, transfer, adjustment
  reference_id uuid null,
  reference_number character varying(100) null,
  
  -- Tracking numbers
  lot_number character varying(100) null,
  serial_number character varying(100) null,
  
  -- Transfer specific (if transaction_type = 'transfer')
  from_store_id uuid null,
  to_store_id uuid null,
  
  -- People
  performed_by character varying(50) null,
  approved_by character varying(50) null,
  
  remarks text null,
  
  created_at timestamp with time zone null default now(),
  
  constraint material_transactions_pkey primary key (id),
  constraint material_transactions_number_key unique (transaction_number),
  constraint material_transactions_inventory_id_fkey foreign key (material_inventory_id) references material_inventory (id) on delete restrict,
  constraint material_transactions_store_id_fkey foreign key (store_id) references stores (id) on delete restrict,
  constraint material_transactions_project_id_fkey foreign key (project_id) references projects (id) on delete cascade,
  constraint material_transactions_from_store_fkey foreign key (from_store_id) references stores (id) on delete restrict,
  constraint material_transactions_to_store_fkey foreign key (to_store_id) references stores (id) on delete restrict
) tablespace pg_default;

create index if not exists idx_material_transactions_inventory on public.material_transactions using btree (material_inventory_id) tablespace pg_default;
create index if not exists idx_material_transactions_store on public.material_transactions using btree (store_id) tablespace pg_default;
create index if not exists idx_material_transactions_project on public.material_transactions using btree (project_id) tablespace pg_default;
create index if not exists idx_material_transactions_type on public.material_transactions using btree (transaction_type) tablespace pg_default;
create index if not exists idx_material_transactions_date on public.material_transactions using btree (transaction_date) tablespace pg_default;
create index if not exists idx_material_transactions_reference on public.material_transactions using btree (reference_type, reference_id) tablespace pg_default;
create index if not exists idx_material_transactions_lot on public.material_transactions using btree (lot_number) tablespace pg_default where (lot_number is not null);
create index if not exists idx_material_transactions_serial on public.material_transactions using btree (serial_number) tablespace pg_default where (serial_number is not null);

comment on table public.material_transactions is 'Complete audit trail of all inventory movements and changes';
comment on column public.material_transactions.transaction_type is 'Types: receive, issue, transfer, adjustment, return';
comment on column public.material_transactions.quantity_change is 'Positive = addition, Negative = deduction';

-- Material Codes: User-defined material codes per project
-- Allows projects to maintain their own coding system
create table public.material_codes (
  id uuid not null default gen_random_uuid(),
  project_id uuid not null,
  material_code character varying(100) not null,
  description text null,
  is_active boolean null default true,
  created_by character varying(50) null,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  
  constraint material_codes_pkey primary key (id),
  constraint material_codes_project_code_key unique (project_id, material_code),
  constraint material_codes_project_id_fkey foreign key (project_id) references projects (id) on delete cascade
) tablespace pg_default;

create index if not exists idx_material_codes_project on public.material_codes using btree (project_id) tablespace pg_default;
create index if not exists idx_material_codes_code on public.material_codes using btree (material_code) tablespace pg_default;
create index if not exists idx_material_codes_active on public.material_codes using btree (is_active) tablespace pg_default;

comment on table public.material_codes is 'User-defined material codes per project - allows custom coding system';
comment on column public.material_codes.material_code is 'Project-specific material code (e.g., MAT-001, STEEL-A, etc.)';
comment on constraint material_codes_project_code_key on public.material_codes is 'Material code must be unique within a project';

-- Material Receives: The ONLY way to add materials to inventory
-- 3-Step Process: Prepare (5.1) → Receive Check (5.2) → Acknowledge (5.3)
create table public.material_receives (
  id uuid not null default gen_random_uuid(),
  receive_number character varying(50) not null default (
    'RCV-'::text || to_char(now(), 'YYYYMMDD-HH24MISS'::text)
  ),
  store_id uuid not null,
  project_id uuid not null,
  company_id uuid null,
  
  -- Reference documents
  purchase_order_id uuid null, -- FK to purchase orders if applicable
  supplier_id uuid null, -- FK to suppliers/vendors
  supplier_invoice_number character varying(100) null,
  delivery_note_number character varying(100) null,
  
  -- Dates
  receive_date date not null default current_date,
  invoice_date date null,
  
  -- 3-Step Workflow Status (status locked after acknowledge)
  status character varying(50) not null default 'prepared'::character varying, 
  -- prepared: Step 5.1 complete
  -- received_all: Step 5.2 complete, all items received as expected
  -- received_with_note: Step 5.2 complete, some items rejected or discrepancy
  -- rejected: Entire receive rejected
  -- Final status after Step 5.3 acknowledge - no further updates allowed
  
  -- Step 5.1: Prepare Material Receive
  prepared_by uuid null, -- FK to users
  prepared_at timestamp with time zone null,
  prepared_photos jsonb null, -- [{url, caption, timestamp}]
  
  -- Step 5.2: Material Check (Store Keeper)
  received_by uuid null, -- FK to users (store keeper)
  received_at timestamp with time zone null,
  received_completed_at timestamp with time zone null, -- When Step 5.2 completed (inventory created, 1-hour edit window starts)
  received_photos jsonb null, -- [{url, caption, timestamp}]
  received_notes text null,
  
  -- Step 5.3: Acknowledge (Approve/Confirm)
  acknowledged_by uuid null, -- FK to users
  acknowledged_at timestamp with time zone null,
  acknowledged_photos jsonb null, -- [{url, caption, timestamp}]
  acknowledged_notes text null,
  
  -- Attachments with Camera/Gallery support (like patrol photos)
  -- Each attachment type supports multiple files
  delivery_order_attachments jsonb null, -- [{url, filename, type: 'camera'|'gallery', timestamp}]
  purchase_order_attachments jsonb null, -- [{url, filename, type: 'camera'|'gallery', timestamp}]
  other_attachments jsonb null, -- [{url, filename, type: 'camera'|'gallery', caption, timestamp}]
  
  -- Notes
  remarks text null,
  rejection_reason text null,
  
  is_locked boolean null default false, -- True after acknowledgment (Step 5.3)
  
  created_by character varying(50) null,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  
  constraint material_receives_pkey primary key (id),
  constraint material_receives_number_key unique (receive_number),
  constraint material_receives_store_id_fkey foreign key (store_id) references stores (id) on delete restrict,
  constraint material_receives_project_id_fkey foreign key (project_id) references projects (id) on delete cascade,
  constraint material_receives_company_id_fkey foreign key (company_id) references companies (id) on delete set null
) tablespace pg_default;

create index if not exists idx_material_receives_store on public.material_receives using btree (store_id) tablespace pg_default;
create index if not exists idx_material_receives_project on public.material_receives using btree (project_id) tablespace pg_default;
create index if not exists idx_material_receives_status on public.material_receives using btree (status) tablespace pg_default;
create index if not exists idx_material_receives_date on public.material_receives using btree (receive_date) tablespace pg_default;
create index if not exists idx_material_receives_number on public.material_receives using btree (receive_number) tablespace pg_default;

comment on table public.material_receives is '3-Step Material Receive Process: Prepare → Receive Check → Acknowledge';
comment on column public.material_receives.status is 'Workflow: prepared → received_all/received_with_note/rejected (locked after acknowledge)';
comment on column public.material_receives.prepared_by is 'Step 5.1: User who prepared the receive document';
comment on column public.material_receives.received_by is 'Step 5.2: Store keeper who checked and confirmed quantities';
comment on column public.material_receives.acknowledged_by is 'Step 5.3: User who acknowledged/approved the receive';
comment on column public.material_receives.is_locked is 'True after Step 5.3 acknowledgment - no further updates allowed';
comment on column public.material_receives.delivery_order_attachments is 'DO attachments: [{url, filename, type: camera|gallery, timestamp}]';
comment on column public.material_receives.purchase_order_attachments is 'PO attachments: [{url, filename, type: camera|gallery, timestamp}]';
comment on column public.material_receives.other_attachments is 'Other attachments: [{url, filename, type: camera|gallery, caption, timestamp}]';
comment on column public.material_receives.prepared_photos is 'Photos taken during Step 5.1 preparation';
comment on column public.material_receives.received_photos is 'Photos taken during Step 5.2 receive check';
comment on column public.material_receives.acknowledged_photos is 'Photos taken during Step 5.3 acknowledgment';
comment on column public.material_receives.received_completed_at is 'When Step 5.2 completed - inventory created, 1-hour edit window starts before Step 5.3 final lock';

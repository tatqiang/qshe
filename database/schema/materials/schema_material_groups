create table public.material_groups (
  id serial not null,
  group_code character varying(50) not null,
  group_name character varying(200) not null,
  group_name_th character varying(200) null,
  description text null,
  sort_order integer null default 0,
  is_active boolean null default true,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  constraint material_groups_pkey primary key (id),
  constraint material_groups_group_code_key unique (group_code)
) TABLESPACE pg_default;

create index IF not exists idx_material_groups_code on public.material_groups using btree (group_code) TABLESPACE pg_default;

create index IF not exists idx_material_groups_active on public.material_groups using btree (is_active) TABLESPACE pg_default;

create index IF not exists idx_material_groups_sort on public.material_groups using btree (sort_order) TABLESPACE pg_default;
create table public.patrol_risk_items (
  id uuid not null default gen_random_uuid (),
  patrol_id uuid not null,
  risk_item_id integer not null,
  created_at timestamp with time zone null default now(),
  constraint patrol_risk_items_pkey primary key (id),
  constraint patrol_risk_items_unique unique (patrol_id, risk_item_id),
  constraint patrol_risk_items_patrol_id_fkey foreign KEY (patrol_id) references safety_patrols (id) on delete CASCADE,
  constraint patrol_risk_items_risk_item_id_fkey foreign KEY (risk_item_id) references risk_items (id)
) TABLESPACE pg_default;
create table public.risk_categories (
  id serial not null,
  name character varying(100) not null,
  description text null,
  color character varying(7) null default '#6B7280'::character varying,
  icon character varying(50) null,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  constraint risk_categories_pkey primary key (id),
  constraint risk_categories_name_key unique (name)
) TABLESPACE pg_default;